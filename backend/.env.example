# ==============================================================
# LIBRARY MANAGEMENT SYSTEM - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================

# Server Port (Default: 5000)
PORT=5000

# Frontend URL for CORS permissions
CLIENT_URL=http://localhost:5173

# --------------------------------------------------------------
# 1. MongoDB Database Connection (MANDATORY WHEN CONNECTING DB)
# --------------------------------------------------------------
# Local MongoDB: mongodb://localhost:27017/library_db
# MongoDB Atlas (Cloud): mongodb+srv://<username>:<password>@cluster0.mongodb.net/library_db?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string

# --------------------------------------------------------------
# 2. JWT Authentication Secret
# --------------------------------------------------------------
# User login aur token generation ke liye secret key
JWT_SECRET=library_management_jwt_secret_key_2026

# --------------------------------------------------------------
# 3. Email Settings (Nodemailer - Forgot Password & OTP)
# --------------------------------------------------------------
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL=your_email@gmail.com

# --------------------------------------------------------------
# 4. Cloudinary Settings (Book Cover Image Uploads)
# --------------------------------------------------------------
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret
